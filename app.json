{
  "expo": {
    "name": "Gathr",
    "slug": "Gathr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Gathr uses your camera to capture photos and videos.",
        "NSMicrophoneUsageDescription": "Gathr needs microphone access to record video.",
        "NSLocationWhenInUseUsageDescription": "Gathr uses your location to tag and group photos by place.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Gathr uses your location to tag and group photos by place."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.arteezy241.Gathr",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Gathr uses your camera to capture photos and videos.",
          "microphonePermission": "Gathr needs microphone access to record video.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Gathr uses your location to tag and group photos by place."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0A84FF"
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Gathr uses the camera to take photos."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c03afb42-2681-43c2-abd0-05bb58dcdd90"
      }
    }
  }
}
